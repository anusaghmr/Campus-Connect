# Server
PORT=5000
NODE_ENV=development

# MongoDB (the project database — change the database name if you like)
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect

# URL of the Vite frontend (used by CORS)
FRONTEND_URL=http://localhost:5173

# Secret used to sign JWTs. Use a long random string in real deployments.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Bootstrap accounts used by `npm run seed` (local development only)
ADMIN_EMAIL=admin.vance@campus.edu
ADMIN_PASSWORD=change-this-admin-password
DEMO_STUDENT_EMAIL=anusha.g@campus.edu
DEMO_STUDENT_PASSWORD=change-this-demo-password
